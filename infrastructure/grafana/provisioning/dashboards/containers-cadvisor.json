      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ]
    },
