          "editorMode": "code",
          "expr": "container_memory_working_set_bytes{name=~\"$container\", name!=\"\"}",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network received",
      "description": "Summed across interfaces. Container-side traffic, so most of it is proxied requests from Traefik.",
