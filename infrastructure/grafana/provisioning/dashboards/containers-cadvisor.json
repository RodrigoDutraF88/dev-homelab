          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Restarts (1h)",
