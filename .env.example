# Copy to .env and fill in. The .env file is gitignored and never committed.
# Loaded explicitly by the Makefile (`--env-file .env`), because the compose
# file lives in compose/ and would otherwise look for a .env in that directory.

# Base domain for Traefik routers: services are exposed at <service>.$DOMAIN
DOMAIN=localhost

# Generate with: htpasswd -nB <user>
# Then double every $ in the resulting hash: Compose interpolates .env values,
# so a single $ is read as a variable reference and silently dropped, which
# truncates the hash and locks you out of the dashboard.
TRAEFIK_DASHBOARD_AUTH=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_PASSWORD=

# Grafana's initial admin login. Only read on first start — once grafana-data
# exists, changing these does nothing and the password must be reset with
# `docker exec grafana grafana cli admin reset-admin-password <new>`.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Optional, both have defaults. Where `make backup` writes Postgres dumps, and
# how long to keep them. The default lives outside the repo on purpose: a
# destructive git operation rebuilds the working tree and would delete backups
# stored inside it.
# BACKUP_DIR=~/dev-homelab-backups
# RETENTION_DAYS=14
