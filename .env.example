# Copy to .env and fill in. The .env file is gitignored and never committed.
# Loaded explicitly by the Makefile (`--env-file .env`), because the compose
# file lives in compose/ and would otherwise look for a .env in that directory.

# Base domain for Traefik routers: services are exposed at <service>.$DOMAIN
# localhost for development (self-signed cert, see `make certs`).
# Set to the real domain to run the TLS overlay: DOMAIN=<name>.duckdns.org
DOMAIN=localhost

# Only needed by the production overlay. From the DuckDNS account page — it is
# what authorises Traefik to publish the TXT record proving domain control, so
# it is a secret like any other.
DUCKDNS_TOKEN=

# Generate with: htpasswd -nB <user>
# Then double every $ in the resulting hash: Compose interpolates .env values,
# so a single $ is read as a variable reference and silently dropped, which
# truncates the hash and locks you out of the dashboard.
TRAEFIK_DASHBOARD_AUTH=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_PASSWORD=

# Grafana's initial admin login. Only read on first start — once grafana-data
# exists, changing these does nothing and the password must be reset with
# `docker exec grafana grafana cli admin reset-admin-password <new>`.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Optional, both have defaults. Where `make backup` writes Postgres dumps, and
# how long to keep them. The default lives outside the repo on purpose: a
# destructive git operation rebuilds the working tree and would delete backups
# stored inside it.
# BACKUP_DIR=~/dev-homelab-backups
# RETENTION_DAYS=14

# Bookshelf app (roadmap item 4). Image comes from GHCR; these are its runtime
# secrets. The OAuth pairs come from the Discord and Google developer consoles —
# their redirect URIs must point at https://bookshelf.$DOMAIN/api/auth/callback/...
# BOOKSHELF_DB_PASSWORD is the app's own role in the shared Postgres, not the
# homelab one. Generate BOOKSHELF_AUTH_SECRET with: openssl rand -base64 36
BOOKSHELF_DB_PASSWORD=
BOOKSHELF_AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GEMINI_API_KEY=
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=
