# Copy to .env and fill in. The .env file is gitignored and never committed.
# Loaded explicitly by the Makefile (`--env-file .env`), because the compose
# file lives in compose/ and would otherwise look for a .env in that directory.

# Base domain for Traefik routers: services are exposed at <service>.$DOMAIN
DOMAIN=localhost

# Generate with: htpasswd -nB <user>
# If you ever inline this in a compose file instead of .env, escape $ as $$.
TRAEFIK_DASHBOARD_AUTH=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_PASSWORD=
